# Supabase — 신규 SaaS 프로젝트 전용 .env.local
# 운영 redone-clan-manager .env.local 과 별도 Supabase 프로젝트를 사용하세요.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key — 서버 전용 (Route Handler, onboarding saga). NEXT_PUBLIC_ 금지.
SUPABASE_SERVICE_ROLE_KEY=

# --- 아래는 로컬/CI 테스트 스크립트 전용 (production Vercel env 불필요) ---
# PHASE1_TEST_PASSWORD=
# PHASE5_GREEN_PASSWORD=

# Production Vercel에는 NEXT_PUBLIC_SUPABASE_* + SUPABASE_SERVICE_ROLE_KEY 3개만 설정.
