# Production Supabase 전용 — Git commit 금지
# 복사: cp .env.production.local.example .env.production.local

# API (Vercel production env와 동일)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Migration runner 전용 (Dashboard → Settings → Database → URI)
# Direct connection 또는 Session pooler (port 5432/6543)
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
